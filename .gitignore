__pycache__/
*.py[cod]
.vscode/
.idea/

# --- local single-GPU runner (run_local.sh) ---
.venv-*/
local/runs/
local/logs/
# Generated by `./run_local.sh yaml`. They embed absolute paths for calib/ and
# the saved-model dirs, so they are machine-specific and must not be committed.
local/yaml/

# --- data / artefacts ---
calib/
*.pkl
*.pt
*.safetensors
datasets/
cache/

# --- crash artefacts ---
# A core dump of this process contains whatever was in memory, including any
# HF_TOKEN. Never commit one.
core.*
*.core

# scratch copies made while patching; never meant to be committed
*.bak
*.bak[0-9]
*.orig

# ---------------------------------------------------------------------------
# Generated results and plots. The result JSONs are caught by the local/runs/
# rule above, never by a *.json pattern -- and *.yaml is deliberately absent
# too: the 52 tracked YAMLs are the experiment configs, not output. Only
# local/yaml/ (machine-specific, generated) is ignored.
# ---------------------------------------------------------------------------
local/plots/
results/
plots/
figures/

*.png
*.pdf
*.svg
*.csv
*.jsonl
*.npz
*.npy

# throwaway probes written while debugging; they carry absolute paths
.probe_*.py
