__pycache__/
*.py[cod]
.vscode/
.idea/

# --- local single-GPU runner (run_local.sh) ---
.venv-*/
local/runs/
local/logs/
# Generated by `./run_local.sh yaml`. They embed absolute paths for calib/ and
# the saved-model dirs, so they are machine-specific and must not be committed.
local/yaml/

# --- data / artefacts ---
calib/
*.pkl
*.pt
*.safetensors
datasets/
cache/

# --- crash artefacts ---
# A core dump of this process contains whatever was in memory, including any
# HF_TOKEN. Never commit one.
core.*
*.core

# scratch copies made while patching; never meant to be committed
*.bak
*.bak[0-9]
*.orig

# --- results & figures: must reach GitHub (double insurance vs. scp) ---
# 'local/runs/' above excludes the DIRECTORY, so git never descends into it and a
# bare '!local/runs/**/*.json' is a no-op. Re-include the dir, re-exclude its
# contents, then negate only the files we want. All five lines are required.
!local/runs/
local/runs/**
!local/runs/**/
!local/runs/**/*.json
!local/runs/**/*.csv
# plots
!figures/**/*.png
!figures/**/*.pdf

